
/routing table
add name=to-ether1 fib
add name=to-ether2 fib
add name=to-ether3 fib
add name=to-ether4 fib




/ip firewall mangle

# =========================
# 0. BYPASS TRAFIK LOKAL
# =========================
add chain=prerouting dst-address-type=local action=accept

# =========================
# 1. MARK CONNECTION (PCC 14)
# =========================

# ether1 (6 bagian)
add chain=prerouting in-interface=OUT connection-mark=no-mark connection-state=new \
    per-connection-classifier=both-addresses:14/0 action=mark-connection new-connection-mark=conn1 passthrough=yes
add chain=prerouting in-interface=OUT connection-mark=no-mark connection-state=new \
    per-connection-classifier=both-addresses:14/1 action=mark-connection new-connection-mark=conn1 passthrough=yes
