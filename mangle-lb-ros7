    per-connection-classifier=both-addresses:14/3 action=mark-connection new-connection-mark=conn1 passthrough=yes
add chain=prerouting in-interface=OUT connection-mark=no-mark connection-state=new \
    per-connection-classifier=both-addresses:14/4 action=mark-connection new-connection-mark=conn1 passthrough=yes
add chain=prerouting in-interface=OUT connection-mark=no-mark connection-state=new \
    per-connection-classifier=both-addresses:14/5 action=mark-connection new-connection-mark=conn1 passthrough=yes

