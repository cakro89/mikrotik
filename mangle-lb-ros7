# =========================
# 2. MARK ROUTING
# =========================

add chain=prerouting in-interface=OUT connection-mark=conn1 action=mark-routing new-routing-mark=to-ether1 passthrough=no
add chain=prerouting in-interface=OUT connection-mark=conn2 action=mark-routing new-routing-mark=to-ether2 passthrough=no
